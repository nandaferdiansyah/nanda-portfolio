# --- Contact form (/contact) ---
# Gmail account that sends the message, plus a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Without these the form returns a "not configured" notice instead of sending.
MAIL_USER=nferdiansyah6@gmail.com
MAIL_PASS=

# Where messages are delivered. Defaults to PROFILE.email when unset.
MAIL_TO=nferdiansyah6@gmail.com

# --- Optional: live Instagram feed on /creations ---
# Without it the page falls back to the post links listed in
# common/constants/creations.ts. See the README for how to generate one.
INSTAGRAM_ACCESS_TOKEN=
